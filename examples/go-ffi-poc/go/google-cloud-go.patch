+{"schema":1,"run_id":"r0","round":1,"time":"2026-11-02T10:00:00Z","backend":"go-json","engine":"go","transport":"json","case":{"name":"old","workload":"read"},"ops":1,"mib_per_s":1}
+`
+
+func TestReport(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "results.jsonl")
+	if err := os.WriteFile(path, []byte(synthetic), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	all, err := readResults(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var rs []result
+	for _, r := range all {
+		if r.RunID == "r1" {
+			rs = append(rs, r)
+		}
+	}
+	var out bytes.Buffer
+	writeReport(&out, "r1", rs)
+	got := out.String()
+	for _, want := range []string{
+		"`n2-standard-16` in `us-central1-a`",
+		"CloudPath (DirectPath disabled for every client)",
+		"| read-16MiB-c8 | rust-json vs go-json (Go default HTTP transport (HTTP/2)) | 1.95x |", // 800 / median(400, 420)
+		"| go-json | 2/2 | 410.0 (400.0–420.0) |",
+		"| rust-json | 1/2 | 800.0 (800.0–800.0) |",
+		"1 failed rounds",
+		"child process: exit status 1",
+		"| 20.0 |", // rust-json FFI calls per op: 1280 / 64
+	} {
+		if !strings.Contains(got, want) {
+			t.Errorf("report lacks %q:\n%s", want, got)
+		}
+	}
+	if strings.Contains(got, "### old") {
+		t.Error("report includes another run's results")
+	}
+}
diff --git a/storage/internal/rustcore/cmd/rustbench/backends.go b/storage/internal/rustcore/cmd/rustbench/backends.go
new file mode 100644
index 0000000..1702096
--- /dev/null
+++ b/storage/internal/rustcore/cmd/rustbench/backends.go
@@ -0,0 +1,291 @@
+// Copyright 2026 Google LLC
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//      http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package main
+
+import (
+	"context"
+	"crypto/tls"
+	"fmt"
+	"io"
+	"net/http"
+	"sort"
+	"strings"
+	"text/tabwriter"
+
+	"cloud.google.com/go/storage"
+	"cloud.google.com/go/storage/experimental"
+	"google.golang.org/api/option"
+	htransport "google.golang.org/api/transport/http"
+)
+
+// Workloads.
+const (
+	wWrite = "write" // upload Size bytes per op (Writer)
+	wRead  = "read"  // download a whole Size-byte object per op (Reader)
+	wRange = "range" // download a random RangeSize window of a Size-byte object per op
+	wList  = "list"  // list every object under a dataset prefix per op (all pages)
+)
+
+var workloads = []string{wWrite, wRead, wRange, wList}
+
+// backend is one client configuration under test.
+type backend struct {
+	name      string
+	engine    string // "go" (the Go SDK's own transports) or "rust" (the Rust core)
+	transport string // "json", "xml" or "grpc"
+	desc      string
+	newClient func(context.Context) (*storage.Client, error)
+	// skip lists workloads this backend does not run, with the reason. A skipped pair would
+	// either be impossible or exactly repeat another backend's measurement.
+	skip map[string]string
+}
+
+var backends = []backend{
+	{
+		name: "go-json", engine: "go", transport: "json",
+		desc: "NewClient + WithJSONReads: JSON API, Go's default HTTP transport (HTTP/2 when negotiated)",
+		newClient: func(ctx context.Context) (*storage.Client, error) {
+			return storage.NewClient(ctx, storage.WithJSONReads())
+		},
+	},
+	{
+		name: "go-json-h1", engine: "go", transport: "json",
+		desc:      "go-json restricted to HTTP/1.1, the protocol of the Rust SDK's JSON transport",
+		newClient: newGoJSONHTTP1,
+	},
+	{
+		name: "go-xml", engine: "go", transport: "xml",
+		desc: "NewClient defaults: XML API reads (what most Go users run today)",
+		newClient: func(ctx context.Context) (*storage.Client, error) {
+			return storage.NewClient(ctx, storage.WithXMLReads())
+		},
+		skip: map[string]string{
+			wWrite: "NewClient uploads over the JSON API (= go-json)",
+			wList:  "NewClient lists over the JSON API (= go-json)",
+		},
+	},
+	{
+		name: "go-grpc", engine: "go", transport: "grpc",
+		desc: "NewGRPCClient, CloudPath: ReadObject (server-streaming) reads, BidiWriteObject uploads",
+		newClient: func(ctx context.Context) (*storage.Client, error) {
+			return storage.NewGRPCClient(ctx)
+		},
+	},
+	{
+		name: "go-grpc-bidi", engine: "go", transport: "grpc",
+		desc: "go-grpc + WithGRPCBidiReads: BidiReadObject reads, the RPC the Rust SDK reads with",
+		newClient: func(ctx context.Context) (*storage.Client, error) {
+			return storage.NewGRPCClient(ctx, storage.WithGRPCBidiReads())
+		},
+		skip: map[string]string{
+			wWrite: "bidi reads do not change uploads (= go-grpc)",
+			wList:  "bidi reads do not change listing (= go-grpc)",
+		},
+	},
+	{
+		name: "rust-json", engine: "rust", transport: "json",
+		desc: "NewClient + WithRustCore: every operation in the Rust core, JSON API over HTTP/1.1",
+		newClient: func(ctx context.Context) (*storage.Client, error) {
+			return storage.NewClient(ctx, experimental.WithRustCore())
+		},
+	},
+	{
+		name: "rust-grpc", engine: "rust", transport: "grpc",
+		desc: "NewGRPCClient + WithRustCore: BidiReadObject reads and v2 ListObjects over gRPC (CloudPath)",
+		newClient: func(ctx context.Context) (*storage.Client, error) {
+			return storage.NewGRPCClient(ctx, experimental.WithRustCore())
+		},
+		skip: map[string]string{
+			wWrite: "the Rust SDK (1.20) has no gRPC upload for standard buckets; uploads use the JSON API (= rust-json)",
+		},
+	},
+}
+
+func lookupBackend(name string) (backend, error) {
+	for _, b := range backends {
+		if b.name == name {
+			return b, nil
+		}
+	}
+	var names []string
+	for _, b := range backends {
+		names = append(names, b.name)
+	}
+	return backend{}, fmt.Errorf("unknown backend %q (have %s)", name, strings.Join(names, ", "))
+}
+
+// newGoJSONHTTP1 builds go-json on a transport that never negotiates HTTP/2: a non-nil, empty
+// TLSNextProto disables net/http's automatic HTTP/2 (see net/http.Transport), and the
+// transport is not handed to x/net/http2 (which the default storage transport is).
+func newGoJSONHTTP1(ctx context.Context) (*storage.Client, error) {
+	base := http.DefaultTransport.(*http.Transport).Clone()
+	base.MaxIdleConnsPerHost = 100 // as the default storage transport
+	base.ForceAttemptHTTP2 = false
+	base.TLSNextProto = map[string]func(string, *tls.Conn) http.RoundTripper{}
+	rt, err := htransport.NewTransport(ctx, base,
+		option.WithScopes(storage.ScopeFullControl, "https://www.googleapis.com/auth/cloud-platform"))
+	if err != nil {
+		return nil, err
+	}
+	return storage.NewClient(ctx, option.WithHTTPClient(&http.Client{Transport: rt}), storage.WithJSONReads())
+}
+
+// benchCase is one workload configuration. Every op of a case does the same work on every
+// backend.
+type benchCase struct {
+	Name        string `json:"name"`
+	Workload    string `json:"workload"`
+	Size        int64  `json:"size,omitempty"`       // object size (write, read), source object size (range)
+	RangeSize   int64  `json:"range_size,omitempty"` // range: bytes per op, at a random offset
+	Concurrency int    `json:"concurrency"`          // workers; each runs its ops one after the other
+	Ops         int    `json:"ops"`                  // measured ops per worker
+	Warmup      int    `json:"warmup"`               // unmeasured ops per worker (connections, tokens)
+	IOBuf       int    `json:"io_buf,omitempty"`     // bytes per Write/Read call by the application (default 1 MiB)
+	Objects     int    `json:"objects,omitempty"`    // list: objects in the listed dataset
+	PageSize    int    `json:"page_size,omitempty"`  // list: page size
+	Delimiter   string `json:"delimiter,omitempty"`  // list: "/" lists the dataset's 100 directories
+	Desc        string `json:"desc,omitempty"`
+}
+
+func (c benchCase) ioBuf() int {
+	if c.IOBuf > 0 {
+		return c.IOBuf
+	}
+	return 1 << 20
+}
+
+const (
+	kib = 1 << 10
+	mib = 1 << 20
+)
+
+// profiles: "default" is the full comparison (about an hour for 5 rounds on a 16-vCPU VM),
+// "quick" a smoke test of the whole pipeline (minutes).
+var profiles = map[string][]benchCase{
+	"default": {
+		{Name: "read-64KiB-c16", Workload: wRead, Size: 64 * kib, Concurrency: 16, Ops: 100, Warmup: 5,
+			Desc: "small-object reads: per-request overhead and latency"},
+		{Name: "read-16MiB-c8", Workload: wRead, Size: 16 * mib, Concurrency: 8, Ops: 8, Warmup: 1,
+			Desc: "medium objects, 8 concurrent streams"},
+		{Name: "read-256MiB-c1", Workload: wRead, Size: 256 * mib, Concurrency: 1, Ops: 4, Warmup: 1,
+			Desc: "large object, single-stream throughput"},
+		{Name: "read-256MiB-c4", Workload: wRead, Size: 256 * mib, Concurrency: 4, Ops: 3, Warmup: 1,
+			Desc: "large objects, 4 concurrent streams"},
+		{Name: "read-16MiB-c8-buf32KiB", Workload: wRead, Size: 16 * mib, Concurrency: 8, Ops: 8, Warmup: 1, IOBuf: 32 * kib,
+			Desc: "as read-16MiB-c8 with 32 KiB Read calls (io.Copy's buffer): per-call overhead"},
+		{Name: "range-64KiB-c16", Workload: wRange, Size: 256 * mib, RangeSize: 64 * kib, Concurrency: 16, Ops: 60, Warmup: 3,
+			Desc: "random 64 KiB windows of 256 MiB objects"},
+		{Name: "range-1MiB-c16", Workload: wRange, Size: 256 * mib, RangeSize: 1 * mib, Concurrency: 16, Ops: 30, Warmup: 2,
+			Desc: "random 1 MiB windows of 256 MiB objects"},
+		{Name: "write-64KiB-c16", Workload: wWrite, Size: 64 * kib, Concurrency: 16, Ops: 50, Warmup: 2,
+			Desc: "small uploads (single request): per-request overhead"},
+		{Name: "write-8MiB-c8", Workload: wWrite, Size: 8 * mib, Concurrency: 8, Ops: 5, Warmup: 1,
+			Desc: "single-request uploads below the 16 MiB chunk size"},
+		{Name: "write-256MiB-c1", Workload: wWrite, Size: 256 * mib, Concurrency: 1, Ops: 3, Warmup: 1,
+			Desc: "resumable upload in 16 MiB chunks, single stream"},
+		{Name: "write-64MiB-c4", Workload: wWrite, Size: 64 * mib, Concurrency: 4, Ops: 3, Warmup: 1,
+			Desc: "resumable uploads, 4 concurrent streams"},
+		{Name: "write-8MiB-c8-buf32KiB", Workload: wWrite, Size: 8 * mib, Concurrency: 8, Ops: 5, Warmup: 1, IOBuf: 32 * kib,
+			Desc: "as write-8MiB-c8 with 32 KiB Write calls (io.Copy's buffer): per-call overhead"},
+		{Name: "list-10k-c1", Workload: wList, Objects: 10000, PageSize: 1000, Concurrency: 1, Ops: 5, Warmup: 1,
+			Desc: "list 10,000 objects in pages of 1,000"},
+		{Name: "list-10k-c8", Workload: wList, Objects: 10000, PageSize: 1000, Concurrency: 8, Ops: 3, Warmup: 1,
+			Desc: "8 concurrent full listings of 10,000 objects"},
+		{Name: "list-10k-delim", Workload: wList, Objects: 10000, PageSize: 1000, Delimiter: "/", Concurrency: 4, Ops: 10, Warmup: 1,
+			Desc: "delimiter listing: the 100 directories of the 10,000-object dataset"},
+	},
+	"quick": {
+		{Name: "read-64KiB-c4", Workload: wRead, Size: 64 * kib, Concurrency: 4, Ops: 10, Warmup: 1},
+		{Name: "read-16MiB-c2", Workload: wRead, Size: 16 * mib, Concurrency: 2, Ops: 2, Warmup: 1},
+		{Name: "range-64KiB-c4", Workload: wRange, Size: 16 * mib, RangeSize: 64 * kib, Concurrency: 4, Ops: 10, Warmup: 1},
+		{Name: "write-64KiB-c4", Workload: wWrite, Size: 64 * kib, Concurrency: 4, Ops: 5, Warmup: 1},
+		{Name: "write-32MiB-c1", Workload: wWrite, Size: 32 * mib, Concurrency: 1, Ops: 1, Warmup: 1},
+		{Name: "list-1k-c1", Workload: wList, Objects: 1000, PageSize: 200, Concurrency: 1, Ops: 2, Warmup: 1},
+	},
+}
+
+func profileNames() []string {
+	var names []string
+	for n := range profiles {
+		names = append(names, n)
+	}
+	sort.Strings(names)
+	return names
+}
+
+func printMatrix(w io.Writer, profile string) {
+	cases := mustProfile(profile)
+	tw := tabwriter.NewWriter(w, 0, 0, 2, ' ', 0)
+	fmt.Fprintln(tw, "BACKEND\tENGINE\tTRANSPORT\tDESCRIPTION")
+	for _, b := range backends {
+		fmt.Fprintf(tw, "%s\t%s\t%s\t%s\n", b.name, b.engine, b.transport, b.desc)
+	}
+	tw.Flush()
+
+	fmt.Fprintln(w)
+	tw = tabwriter.NewWriter(w, 0, 0, 2, ' ', 0)
+	fmt.Fprint(tw, "WORKLOAD")
+	for _, b := range backends {
+		fmt.Fprintf(tw, "\t%s", b.name)
+	}
+	fmt.Fprintln(tw)
+	for _, wl := range workloads {
+		fmt.Fprint(tw, wl)
+		for _, b := range backends {
+			mark := "run"
+			if _, skip := b.skip[wl]; skip {
+				mark = "skip"
+			}
+			fmt.Fprintf(tw, "\t%s", mark)
+		}
+		fmt.Fprintln(tw)
+	}
+	tw.Flush()
+
+	fmt.Fprintln(w, "\nSkipped pairs:")
+	for _, b := range backends {
+		for _, wl := range workloads {
+			if why, skip := b.skip[wl]; skip {
+				fmt.Fprintf(w, "  %-13s %-6s %s\n", b.name, wl, why)
+			}
+		}
+	}
+
+	fmt.Fprintf(w, "\nCases of profile %q:\n", profile)
+	tw = tabwriter.NewWriter(w, 0, 0, 2, ' ', 0)
+	fmt.Fprintln(tw, "CASE\tWORKLOAD\tSIZE\tRANGE\tWORKERS\tOPS/WORKER\tIO BUF\tDESCRIPTION")
+	for _, c := range cases {
+		size, rng, iobuf := humanBytes(c.Size), humanBytes(c.RangeSize), humanBytes(int64(c.ioBuf()))
+		if c.Workload == wList {
+			size, iobuf = fmt.Sprintf("%d objects", c.Objects), "-"
+		}
+		fmt.Fprintf(tw, "%s\t%s\t%s\t%s\t%d\t%d (+%d warmup)\t%s\t%s\n",
+			c.Name, c.Workload, size, rng, c.Concurrency, c.Ops, c.Warmup, iobuf, c.Desc)
+	}
+	tw.Flush()
+}
+
+func humanBytes(n int64) string {
+	switch {
+	case n == 0:
+		return "-"
+	case n%mib == 0:
+		return fmt.Sprintf("%dMiB", n/mib)
+	case n%kib == 0:
+		return fmt.Sprintf("%dKiB", n/kib)
+	default:
+		return fmt.Sprintf("%dB", n)
+	}
+}
diff --git a/storage/internal/rustcore/cmd/rustbench/dataset.go b/storage/internal/rustcore/cmd/rustbench/dataset.go
new file mode 100644
index 0000000..50499e4
--- /dev/null
+++ b/storage/internal/rustcore/cmd/rustbench/dataset.go
@@ -0,0 +1,189 @@
+// Copyright 2026 Google LLC
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//      http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package main
+
+// Datasets live under <prefix>/data/ and are shared by all backends and rounds:
+//
+//	<prefix>/data/read/<size>/<i>                read and range sources (datasetCount(size) each)
+//	<prefix>/data/list-<n>/<dir>/<i>             n empty objects spread over listDirs(n) directories
+//
+// Written objects go to <prefix>/write/... and are deleted by the process that wrote them.
+// setup and cleanup always use the pure-Go JSON client, never a client under test.
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"log"
+	"sort"
+	"strings"
+	"time"
+
+	"cloud.google.com/go/storage"
+	"google.golang.org/api/iterator"
+)
+
+// datasetCount is the number of source objects per read size: enough for the concurrency the
+// profiles use, so concurrent workers read different objects.
+func datasetCount(size int64) int {
+	switch {
+	case size <= 1*mib:
+		return 16
+	case size <= 64*mib:
+		return 8
+	default:
+		return 4
+	}
+}
+
+func readObjectName(prefix string, size int64, i int) string {
+	return fmt.Sprintf("%s/data/read/%s/%03d", prefix, humanBytes(size), i)
+}
+
+func listPrefix(prefix string, n int) string { return fmt.Sprintf("%s/data/list-%d/", prefix, n) }
+
+// listDirs is the number of directories (delimiter prefixes) of the n-object list dataset.
+func listDirs(n int) int { return min(100, n) }
+
+func listObjectName(prefix string, n, i int) string {
+	return fmt.Sprintf("%s%03d/%06d", listPrefix(prefix, n), i%listDirs(n), i)
+}
+
+// datasetPlan returns every dataset object a profile needs, with its size.
+func datasetPlan(prefix string, cases []benchCase) map[string]int64 {
+	plan := map[string]int64{}
+	for _, c := range cases {
+		switch c.Workload {
+		case wRead, wRange:
+			for i := range datasetCount(c.Size) {
+				plan[readObjectName(prefix, c.Size, i)] = c.Size
+			}
+		case wList:
+			for i := range c.Objects {
+				plan[listObjectName(prefix, c.Objects, i)] = 0
+			}
+		}
+	}
+	return plan
+}
+
+func checkPrefix(prefix string) error {
+	if strings.Trim(prefix, "/") == "" {
+		return errors.New("-prefix must not be empty")
+	}
+	return nil
+}
+
+// setupDatasets creates the missing dataset objects of a profile (idempotent: objects that
+// exist with the right size are kept).
+func setupDatasets(ctx context.Context, bucket, prefix string, cases []benchCase) error {
+	if err := checkPrefix(prefix); err != nil {
+		return err
+	}
+	c, err := storage.NewClient(ctx)
+	if err != nil {
+		return err
+	}
+	defer c.Close()
+	bkt := c.Bucket(bucket)
+	plan := datasetPlan(prefix, cases)
+	existing := map[string]int64{}
+	it := bkt.Objects(ctx, &storage.Query{Prefix: prefix + "/data/"})
+	for {
+		a, err := it.Next()
+		if err == iterator.Done {
+			break
+		}
+		if err != nil {
+			return fmt.Errorf("listing existing datasets: %w", err)
+		}
+		existing[a.Name] = a.Size
+	}
+	var todo []string
+	var total, missing int64
+	for name, size := range plan {
+		total += size
+		if s, ok := existing[name]; !ok || s != size {
+			todo = append(todo, name)
+			missing += size
+		}
+	}
+	sort.Strings(todo)
+	log.Printf("datasets under gs://%s/%s/data/: %d objects (%.1f MiB); creating %d (%.1f MiB)",
+		bucket, prefix, len(plan), float64(total)/mib, len(todo), float64(missing)/mib)
+	if len(todo) == 0 {
+		return nil
+	}
+	var maxSize int64
+	for _, n := range todo {
+		maxSize = max(maxSize, plan[n])
+	}
+	data := randomBytes(int(maxSize), 2)
+	start := time.Now()
+	failed := parallelDo(ctx, len(todo), 64, func(ctx context.Context, i int) error {
+		name := todo[i]
+		w := bkt.Object(name).NewWriter(ctx)
+		if _, err := w.Write(data[:plan[name]]); err != nil {
+			w.Close()
+			return fmt.Errorf("%s: %w", name, err)
+		}
+		if err := w.Close(); err != nil {
+			return fmt.Errorf("%s: %w", name, err)
+		}
+		return nil
+	})
+	if failed > 0 {
+		return fmt.Errorf("could not create %d dataset objects", failed)
+	}
+	log.Printf("created %d dataset objects in %v", len(todo), time.Since(start).Round(time.Second))
+	return nil
+}
+
+// cleanupPrefix deletes every object under prefix/ (datasets and leftovers of interrupted runs).
+func cleanupPrefix(ctx context.Context, bucket, prefix string) error {
+	if err := checkPrefix(prefix); err != nil {
+		return err
+	}
+	c, err := storage.NewClient(ctx)
+	if err != nil {
+		return err
+	}
+	defer c.Close()
+	bkt := c.Bucket(bucket)
+	var names []string
+	it := bkt.Objects(ctx, &storage.Query{Prefix: strings.TrimSuffix(prefix, "/") + "/"})
+	for {
+		a, err := it.Next()
+		if err == iterator.Done {
+			break
+		}
+		if err != nil {
+			return err
+		}
+		names = append(names, a.Name)
+	}
+	log.Printf("deleting %d objects under gs://%s/%s/", len(names), bucket, prefix)
+	failed := parallelDo(ctx, len(names), 64, func(ctx context.Context, i int) error {
+		err := bkt.Object(names[i]).Delete(ctx)
+		if errors.Is(err, storage.ErrObjectNotExist) {
+			return nil
+		}
+		return err
+	})
+	if failed > 0 {
+		return fmt.Errorf("could not delete %d objects", failed)
+	}
+	return nil
+}
diff --git a/storage/internal/rustcore/cmd/rustbench/main.go b/storage/internal/rustcore/cmd/rustbench/main.go
new file mode 100644
index 0000000..b5a4786
--- /dev/null
+++ b/storage/internal/rustcore/cmd/rustbench/main.go
@@ -0,0 +1,172 @@
+// Copyright 2026 Google LLC
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//      http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+// Command rustbench benchmarks the Go SDK's own transports against the shared Rust core
+// (experimental.WithRustCore) on the data-path APIs: object writes (WriteObject), full and
+// ranged reads (ReadObject) and listing (ListObjects), over the JSON API and gRPC (CloudPath;
+// the Rust SDK has no DirectPath).
+//
+// Build (cgo, linux/amd64; build the Rust core first with ../../build.sh):
+//
+//	go build -tags gcsrust -o rustbench ./internal/rustcore/cmd/rustbench
+//
+// Subcommands:
+//
+//	rustbench matrix                                   backends x workloads, skips and reasons
+//	rustbench setup   -bucket B -prefix P              create the read and list datasets
+//	rustbench suite   -bucket B -prefix P -out F.jsonl run the whole profile (see below)
+//	rustbench run     -bucket B -prefix P -backend X -case NAME   one case in this process
+//	rustbench cleanup -bucket B -prefix P              delete every object under the prefix
+//
+// suite runs every (case, backend) pair of a profile in its own child process (`rustbench run`),
+// in a new random order every round, and appends one JSON line per pair and round to -out.
+// CPU time and memory are per process, so they cover everything a client does (Go and Rust
+// threads alike). Summarize the results with ../rustbench-report. To run on a GCE VM, see
+// ../../bench/README.md.
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"log"
+	"os"
+	"strings"
+	"time"
+)
+
+func usage() {
+	fmt.Fprint(os.Stderr, `usage: rustbench <matrix|setup|suite|run|cleanup> [flags]
+
+  matrix    print the backend x workload matrix (with the reasons for skipped pairs)
+  setup     create the datasets of a profile under -prefix (idempotent)
+  suite     run every (case, backend) pair of a profile, one child process each, -rounds times
+  run       run one case with one backend in this process and print a JSON result line
+  cleanup   delete every object under -prefix
+
+Run "rustbench <subcommand> -h" for the flags of a subcommand.
+`)
+	os.Exit(2)
+}
+
+func main() {
+	log.SetFlags(log.Ltime | log.Lmicroseconds)
+	log.SetPrefix("rustbench: ")
+	if len(os.Args) < 2 {
+		usage()
+	}
+	ctx := context.Background()
+	cmd, args := os.Args[1], os.Args[2:]
+	switch cmd {
+	case "matrix":
+		fs := flag.NewFlagSet("matrix", flag.ExitOnError)
+		profile := fs.String("profile", "default", "profile: "+strings.Join(profileNames(), " | "))
+		fs.Parse(args)
+		printMatrix(os.Stdout, *profile)
+	case "setup":
+		fs := flag.NewFlagSet("setup", flag.ExitOnError)
+		bucket, prefix := bucketFlags(fs)
+		profile := fs.String("profile", "default", "profile whose datasets to create")
+		fs.Parse(args)
+		if err := setupDatasets(ctx, mustBucket(*bucket), *prefix, mustProfile(*profile)); err != nil {
+			log.Fatal(err)
+		}
+	case "cleanup":
+		fs := flag.NewFlagSet("cleanup", flag.ExitOnError)
+		bucket, prefix := bucketFlags(fs)
+		fs.Parse(args)
+		if err := cleanupPrefix(ctx, mustBucket(*bucket), *prefix); err != nil {
+			log.Fatal(err)
+		}
+	case "run":
+		fs := flag.NewFlagSet("run", flag.ExitOnError)
+		bucket, prefix := bucketFlags(fs)
+		backend := fs.String("backend", "", "backend name (see `rustbench matrix`)")
+		caseName := fs.String("case", "", "case name from -profile (or use -case-json)")
+		caseJSON := fs.String("case-json", "", "the case as JSON (used by suite)")
+		profile := fs.String("profile", "default", "profile containing -case")
+		runID := fs.String("run-id", "", "run id recorded in the result")
+		round := fs.Int("round", 0, "round number recorded in the result")
+		fs.Parse(args)
+		c, err := resolveCase(*caseName, *caseJSON, *profile)
+		if err != nil {
+			log.Fatal(err)
+		}
+		res, err := runCase(ctx, mustBucket(*bucket), *prefix, *backend, c)
+		if err != nil {
+			log.Fatalf("%s/%s: %v", c.Name, *backend, err)
+		}
+		res.RunID, res.Round = *runID, *round
+		if err := json.NewEncoder(os.Stdout).Encode(res); err != nil {
+			log.Fatal(err)
+		}
+	case "suite":
+		fs := flag.NewFlagSet("suite", flag.ExitOnError)
+		bucket, prefix := bucketFlags(fs)
+		var o suiteOptions
+		fs.StringVar(&o.profile, "profile", "default", "profile: "+strings.Join(profileNames(), " | "))
+		fs.IntVar(&o.rounds, "rounds", 5, "rounds; every round runs every pair once, in a new random order")
+		fs.StringVar(&o.out, "out", "results.jsonl", "JSON-lines output file (appended to)")
+		fs.StringVar(&o.backends, "backends", "", "comma-separated backends (default: all)")
+		fs.StringVar(&o.cases, "cases", "", "comma-separated case names (default: all in the profile)")
+		fs.StringVar(&o.runID, "run-id", time.Now().UTC().Format("20060102T150405Z"), "run id recorded in every result")
+		fs.Int64Var(&o.seed, "seed", time.Now().UnixNano(), "shuffle seed (recorded in the log)")
+		fs.BoolVar(&o.setup, "setup", true, "create the datasets first (idempotent)")
+		fs.DurationVar(&o.timeout, "timeout", 30*time.Minute, "timeout per child process")
+		fs.DurationVar(&o.cooldown, "cooldown", 2*time.Second, "pause between child processes")
+		fs.Parse(args)
+		o.bucket, o.prefix = mustBucket(*bucket), *prefix
+		if err := runSuite(ctx, o); err != nil {
+			log.Fatal(err)
+		}
+	default:
+		usage()
+	}
+}
+
+func bucketFlags(fs *flag.FlagSet) (bucket, prefix *string) {
+	bucket = fs.String("bucket", os.Getenv("RUSTBENCH_BUCKET"), "bucket (default $RUSTBENCH_BUCKET)")
+	prefix = fs.String("prefix", "rustbench", "object name prefix for datasets and written objects")
+	return bucket, prefix
+}
+
+func mustBucket(b string) string {
+	if b == "" {
+		log.Fatal("-bucket (or $RUSTBENCH_BUCKET) is required")
+	}
+	return b
+}
+
+func mustProfile(name string) []benchCase {
+	p, ok := profiles[name]
+	if !ok {
+		log.Fatalf("unknown profile %q (have %s)", name, strings.Join(profileNames(), ", "))
+	}
+	return p
+}
+
+func resolveCase(name, js, profile string) (benchCase, error) {
+	if js != "" {
+		var c benchCase
+		err := json.Unmarshal([]byte(js), &c)
+		return c, err
+	}
+	for _, c := range mustProfile(profile) {
+		if c.Name == name {
+			return c, nil
+		}
+	}
+	return benchCase{}, fmt.Errorf("no case %q in profile %q (see `rustbench matrix -profile %s`)", name, profile, profile)
+}
