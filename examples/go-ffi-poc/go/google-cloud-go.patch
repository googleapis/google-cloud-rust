new file mode 100755
index 0000000..108f026
--- /dev/null
+++ b/storage/internal/rustcore/bench/vm/push_code.sh
@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+# Copies the local storage module to the VM (workstation): the working tree as it is, including
+# uncommitted changes and new files, but not git-ignored build outputs (the Rust core is rebuilt
+# on the VM). Nothing is pushed to any git remote. Re-run after every local change.
+set -euo pipefail
+here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+# shellcheck source=config.sh
+source "$here/config.sh"
+repo="$(git -C "$here" rev-parse --show-toplevel)"
+tmp="$(mktemp -d)"
+trap 'rm -rf "$tmp"' EXIT
+
+# Provenance, recorded in every result line (RUSTBENCH_SOURCE).
+rev="$(git -C "$repo" rev-parse --short HEAD)"
+branch="$(git -C "$repo" rev-parse --abbrev-ref HEAD)"
+changed="$(git -C "$repo" status --porcelain -- storage | wc -l | tr -d ' ')"
+echo "branch $branch at $rev with $changed uncommitted path(s) under storage/; packed $(date -u +%FT%TZ) on $(hostname)" > "$tmp/SOURCE"
+
+# Tracked and untracked (not ignored) files that exist in the working tree.
+git -C "$repo" ls-files -co --exclude-standard -- storage |
+  while IFS= read -r f; do [[ -f "$repo/$f" ]] && printf '%s\n' "$f"; done > "$tmp/files"
+tar -C "$repo" -czf "$tmp/src.tgz" -T "$tmp/files"
+echo "packed $(wc -l < "$tmp/files" | tr -d ' ') files ($(du -h "$tmp/src.tgz" | cut -f1)): $(cat "$tmp/SOURCE")"
+
+gcloud compute scp "${GCLOUD_FLAGS[@]}" "$tmp/src.tgz" "$tmp/SOURCE" "$here/setup_vm.sh" "$here/run_bench.sh" "$VM:~/"
+gcloud compute ssh "$VM" "${GCLOUD_FLAGS[@]}" --command \
+  'set -e; rm -rf ~/src; mkdir -p ~/src; tar -xzf ~/src.tgz -C ~/src; chmod +x ~/setup_vm.sh ~/run_bench.sh; echo "unpacked into ~/src"'
+echo
+echo "next (first time, or after changing Rust code): gcloud compute ssh $VM ${GCLOUD_FLAGS[*]} --command '~/setup_vm.sh'"
diff --git a/storage/internal/rustcore/bench/vm/run_bench.sh b/storage/internal/rustcore/bench/vm/run_bench.sh
new file mode 100755
index 0000000..58bb8ed
--- /dev/null
+++ b/storage/internal/rustcore/bench/vm/run_bench.sh
@@ -0,0 +1,41 @@
+#!/usr/bin/env bash
+# Runs ON the VM: the benchmark suite, then the Markdown report. Takes about an hour with the
+# default profile and 5 rounds; start it with start_remote.sh so it survives ssh disconnects.
+#
+#   BUCKET=my-bucket [PROFILE=default|quick] [ROUNDS=5] [BACKENDS=go-json,rust-json] \
+#     [CASES=read-16MiB-c8,list-10k-c1] [CLEANUP=1] ~/run_bench.sh
+#
+# Results: ~/results/<run id>/{results.jsonl,report.md,suite.log,matrix.txt}.
+set -euo pipefail
+: "${BUCKET:?set BUCKET}"
+PROFILE="${PROFILE:-default}"
+ROUNDS="${ROUNDS:-5}"
+PREFIX="${PREFIX:-rustbench/$(hostname)}"
+RUN_ID="${RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)}"
+OUT="$HOME/results/$RUN_ID"
+mkdir -p "$OUT"
+
+# CloudPath for every client: the Rust SDK has no DirectPath (rustbench enforces this as well).
+export GOOGLE_CLOUD_DISABLE_DIRECT_PATH=true
+RUSTBENCH_SOURCE="$(cat ~/SOURCE 2>/dev/null || echo unknown)"
+export RUSTBENCH_SOURCE
+
+args=(suite -bucket "$BUCKET" -prefix "$PREFIX" -profile "$PROFILE" -rounds "$ROUNDS" -run-id "$RUN_ID" -out "$OUT/results.jsonl")
+if [[ -n "${BACKENDS:-}" ]]; then args+=(-backends "$BACKENDS"); fi
+if [[ -n "${CASES:-}" ]]; then args+=(-cases "$CASES"); fi
+
+{
+  echo "run $RUN_ID on $(hostname): profile $PROFILE, $ROUNDS rounds, gs://$BUCKET/$PREFIX"
+  echo "source: $RUSTBENCH_SOURCE"
+  echo
+  ~/bin/rustbench matrix -profile "$PROFILE"
+} > "$OUT/matrix.txt"
+
+~/bin/rustbench "${args[@]}" 2>&1 | tee "$OUT/suite.log"
+~/bin/rustbench-report -run "$RUN_ID" "$OUT/results.jsonl" > "$OUT/report.md"
+echo "report: $OUT/report.md"
+
+if [[ "${CLEANUP:-0}" == "1" ]]; then
+  # Deletes the datasets (and leftovers of interrupted runs) under the prefix only.
+  ~/bin/rustbench cleanup -bucket "$BUCKET" -prefix "$PREFIX"
+fi
