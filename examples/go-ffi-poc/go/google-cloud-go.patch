+++ b/storage/internal/rustcore/bench/vm/setup_vm.sh
@@ -0,0 +1,38 @@
+#!/usr/bin/env bash
+# Runs ON the VM: installs Go and Rust, builds the Rust core on the VM itself (so the static
+# library matches the VM's toolchain and glibc) and the benchmark binaries. Safe to re-run; it
+# rebuilds from ~/src (refresh it with push_code.sh).
+set -euo pipefail
+GO_VERSION="${GO_VERSION:-1.26.8}"         # must satisfy the go directive of storage/go.mod
+RUST_TOOLCHAIN="${RUST_TOOLCHAIN:-stable}" # the core needs Rust >= 1.85 (edition 2024)
+
+sudo apt-get update -qq
+sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq build-essential ca-certificates curl git
+
+if [[ "$(/usr/local/go/bin/go env GOVERSION 2>/dev/null || true)" != "go${GO_VERSION}" ]]; then
+  echo "installing Go ${GO_VERSION}"
+  curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" -o /tmp/go.tgz
+  sudo rm -rf /usr/local/go
+  sudo tar -C /usr/local -xzf /tmp/go.tgz
+fi
+export PATH="/usr/local/go/bin:$HOME/go/bin:$PATH"
+
+if [[ ! -x "$HOME/.cargo/bin/cargo" ]]; then
+  echo "installing Rust (${RUST_TOOLCHAIN})"
+  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain "$RUST_TOOLCHAIN"
+fi
+# shellcheck source=/dev/null
+source "$HOME/.cargo/env"
+
+cd ~/src/storage
+./internal/rustcore/build.sh # release build: about 3 minutes on 16 vCPUs
+mkdir -p ~/bin
+go build -tags gcsrust -o ~/bin/rustbench ./internal/rustcore/cmd/rustbench
+go build -o ~/bin/rustbench-report ./internal/rustcore/cmd/rustbench-report
+
+echo
+go version
+rustc --version
+~/bin/rustbench matrix
+echo
+echo "setup done. Next, from your workstation: start_remote.sh (or on the VM: BUCKET=... ~/run_bench.sh)"
diff --git a/storage/internal/rustcore/bench/vm/start_remote.sh b/storage/internal/rustcore/bench/vm/start_remote.sh
new file mode 100755
index 0000000..c7b3aed
--- /dev/null
+++ b/storage/internal/rustcore/bench/vm/start_remote.sh
@@ -0,0 +1,18 @@
+#!/usr/bin/env bash
+# Starts run_bench.sh on the VM in the background (workstation) and returns immediately; the run
+# survives ssh disconnects. Same variables as run_bench.sh:
+#
+#   [PROFILE=quick] [ROUNDS=1] [BACKENDS=...] [CASES=...] [CLEANUP=1] ./start_remote.sh
+set -euo pipefail
+here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+# shellcheck source=config.sh
+source "$here/config.sh"
+
+vars="BUCKET=$BUCKET PROFILE=${PROFILE:-default} ROUNDS=${ROUNDS:-5} CLEANUP=${CLEANUP:-0}"
+if [[ -n "${BACKENDS:-}" ]]; then vars+=" BACKENDS=$BACKENDS"; fi
+if [[ -n "${CASES:-}" ]]; then vars+=" CASES=$CASES"; fi
+
+gcloud compute ssh "$VM" "${GCLOUD_FLAGS[@]}" --command \
+  "nohup env $vars ~/run_bench.sh > ~/rustbench-run.log 2>&1 < /dev/null & echo \"started ($vars)\""
+echo "follow:  gcloud compute ssh $VM ${GCLOUD_FLAGS[*]} --command 'tail -f ~/rustbench-run.log'"
+echo "results: $here/fetch_results.sh"
diff --git a/storage/internal/rustcore/build.sh b/storage/internal/rustcore/build.sh
new file mode 100755
index 0000000..27e0af8
--- /dev/null
+++ b/storage/internal/rustcore/build.sh
@@ -0,0 +1,36 @@
+#!/usr/bin/env bash
+# Builds the Rust GCS engine (gcs_core v2) and installs the static library where the cgo
+# bindings link it from: internal/rustcore/lib/<goos>_<goarch>/libgcs_core.a
+#
+# Usage (from anywhere):
+#   storage/internal/rustcore/build.sh            # release build, ring crypto provider (default)
+#   CRYPTO=aws-lc storage/internal/rustcore/build.sh
+#
+# Requirements: rustup/cargo (https://rustup.rs). The aws-lc provider additionally needs cmake
+# and a C compiler; the default ring provider does not.
+set -euo pipefail
+
+here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+if ! command -v cargo >/dev/null 2>&1 && [ -f "$HOME/.cargo/env" ]; then
+  # shellcheck disable=SC1091
+  . "$HOME/.cargo/env"
+fi
+command -v cargo >/dev/null || { echo "cargo not found; install Rust via https://rustup.rs" >&2; exit 1; }
+
+features=()
+case "${CRYPTO:-ring}" in
+  ring) ;;
+  aws-lc) features=(--no-default-features --features crypto-aws-lc) ;;
+  *) echo "CRYPTO must be ring or aws-lc" >&2; exit 1 ;;
+esac
+
+goos="$(go env GOOS)"
+goarch="$(go env GOARCH)"
+echo "rustc: $(rustc --version)"
+echo "building gcs_core for ${goos}/${goarch} (crypto=${CRYPTO:-ring}) ..."
+(cd "$here/gcs_core" && cargo build --release --locked "${features[@]}")
+
+target_dir="${CARGO_TARGET_DIR:-$here/gcs_core/target}"
+mkdir -p "$here/lib/${goos}_${goarch}"
+cp "$target_dir/release/libgcs_core.a" "$here/lib/${goos}_${goarch}/libgcs_core.a"
+echo "installed $here/lib/${goos}_${goarch}/libgcs_core.a ($(du -h "$here/lib/${goos}_${goarch}/libgcs_core.a" | cut -f1))"
diff --git a/storage/internal/rustcore/callbacks.go b/storage/internal/rustcore/callbacks.go
new file mode 100644
index 0000000..64f6a7b
--- /dev/null
+++ b/storage/internal/rustcore/callbacks.go
@@ -0,0 +1,153 @@
+// Copyright 2026 Google LLC
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//      http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+//go:build gcsrust && cgo && linux && amd64
+
+package rustcore
+
+// Exported callbacks live in their own file: a cgo preamble in a file with //export may only
+// contain declarations.
+
+/*
+#include <stdlib.h>
+#include "gcs_core.h"
+*/
+import "C"
+
+import (
+	"context"
+	"fmt"
+	"runtime/cgo"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+// result is what an async completion delivers to the waiting goroutine.
+type result struct {
+	err *Error // nil on success
+	n   uint64
+}
+
+//export rustcoreDone
+func rustcoreDone(user C.uintptr_t, st C.GcsStatus, n C.uint64_t) {
+	// Runs on a Rust runtime thread. The channel is buffered (cap 1) and receives exactly one
+	// value per pending operation, so this never blocks the Rust runtime. Deliberately no
+	// recover: the handle is owned by a goroutine that is blocked on it, so a failure here is
+	// a binding bug, and swallowing it would hang that goroutine forever.
+	ch := cgo.Handle(user).Value().(chan result)
+	ch <- result{err: takeStatus(st), n: uint64(n)}
+}
+
+// Values the core may call back into (token sources, retry predicates) are kept in a registry
+// under IDs that are never reused, instead of cgo.Handles: a call for an ID that was already
+// released fails cleanly (cgo.Handle.Value panics), and release is idempotent. The core
+// releases each ID through rustcoreRelease after its last use.
+var (
+	registry   sync.Map // uint64 -> any
+	registryID atomic.Uint64
+)
+
+func register(v any) uint64 {
+	id := registryID.Add(1)
+	registry.Store(id, v)
+	return id
+}
+
+func lookup(id uint64) (any, bool) { return registry.Load(id) }
+
+func unregister(id uint64) { registry.Delete(id) }
+
+// registered reports the number of live registry entries (for leak tests).
+func registered() int {
+	n := 0
+	registry.Range(func(any, any) bool { n++; return true })
+	return n
+}
+
+//export rustcoreRelease
+func rustcoreRelease(id C.uintptr_t) { unregister(uint64(id)) }
+
+// TokenSource supplies OAuth2 access tokens to the core (GCS_AUTH_TOKEN_CALLBACK). It lets the
+// core use exactly the credentials the Go client was configured with.
+type TokenSource interface {
+	Token(ctx context.Context) (token string, expiry time.Time, err error)
+}
+
+const tokenTimeout = 60 * time.Second
+
+//export rustcoreToken
+func rustcoreToken(user C.uintptr_t, outToken **C.char, outExpiry *C.int64_t, outErr **C.char) (rc C.int32_t) {
+	// Runs on a Tokio blocking-pool thread (never on an async worker). A panic must not unwind
+	// into Rust: report it as a token error instead.
+	defer func() {
+		if r := recover(); r != nil {
+			*outErr = C.CString(fmt.Sprintf("rustcore: token source panicked: %v", r))
+			rc = 1
+		}
+	}()
+	v, ok := lookup(uint64(user))
+	if !ok {
+		*outErr = C.CString("rustcore: token source already released")
+		return 1
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), tokenTimeout)
+	defer cancel()
+	tok, exp, err := v.(TokenSource).Token(ctx)
+	if err != nil {
+		*outErr = C.CString(err.Error())
+		return 1
+	}
+	*outToken = C.CString(tok) // freed by Rust with free(3)
+	if !exp.IsZero() {
+		*outExpiry = C.int64_t(exp.Unix())
+	}
+	return 0
+}
+
+// RetryPredicate classifies an error reported by the core: true = retry. Idempotency and the
+// retry policy are still enforced by the core; the predicate only classifies errors. It runs
+// on a core thread and must be fast.
+type RetryPredicate func(err *Error, attempt int) bool
+
+// RegisterRetryPredicate makes p callable by the core and returns the ID to put in the
+// options JSON (retry.predicate). The core releases the ID after its last use; release is
+// for the caller's own error paths (before the options reached the core) and is idempotent.
+func RegisterRetryPredicate(p RetryPredicate) (id uint64, release func()) {
+	id = register(p)
+	return id, func() { unregister(id) }
+}
+
+// evalPredicate runs the predicate registered under id; unknown (released) IDs and panics
+// mean "do not retry".
+func evalPredicate(id uint64, err *Error, attempt int) (retry bool) {
+	defer func() {
+		if r := recover(); r != nil {
+			retry = false
+		}
+	}()
+	v, ok := lookup(id)
+	if !ok || err == nil {
+		return false
+	}
+	return v.(RetryPredicate)(err, attempt)
+}
+
+//export rustcoreRetry
+func rustcoreRetry(predicate C.uintptr_t, st C.GcsStatus, attempt C.uint32_t) C.int32_t {
+	if evalPredicate(uint64(predicate), takeStatus(st), int(attempt)) {
+		return 1
+	}
+	return 0
+}
