+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"log"
+	"math/rand/v2"
+	"os"
+	"os/exec"
+	"slices"
+	"strconv"
+	"strings"
+	"time"
+)
+
+type suiteOptions struct {
+	bucket, prefix, profile, out string
+	backends, cases, runID       string
+	rounds                       int
+	seed                         int64
+	setup                        bool
+	timeout, cooldown            time.Duration
+}
+
+type pair struct {
+	c benchCase
+	b backend
+}
+
+// runSuite runs every (case, backend) pair of the profile once per round, each in a fresh
+// child process, in a new random order every round (so that slow drifts of the network or the
+// service spread over all backends instead of biasing one).
+func runSuite(ctx context.Context, o suiteOptions) error {
+	cases := mustProfile(o.profile)
+	if o.cases != "" {
+		want := strings.Split(o.cases, ",")
+		cases = slices.DeleteFunc(slices.Clone(cases), func(c benchCase) bool { return !slices.Contains(want, c.Name) })
+	}
+	bes := backends
+	if o.backends != "" {
+		bes = nil
+		for _, name := range strings.Split(o.backends, ",") {
+			b, err := lookupBackend(strings.TrimSpace(name))
+			if err != nil {
+				return err
+			}
+			bes = append(bes, b)
+		}
+	}
+	var pairs []pair
+	for _, c := range cases {
+		for _, b := range bes {
+			if _, skip := b.skip[c.Workload]; !skip {
+				pairs = append(pairs, pair{c, b})
+			}
+		}
+	}
+	if len(pairs) == 0 {
+		return errors.New("no (case, backend) pairs selected")
+	}
+
+	// The Rust SDK has no DirectPath; keep Go's gRPC client on CloudPath too, unless asked.
+	if os.Getenv("RUSTBENCH_ALLOW_DIRECTPATH") == "" {
+		os.Setenv("GOOGLE_CLOUD_DISABLE_DIRECT_PATH", "true")
+	}
+	env := collectEnv(ctx, o)
+	if env.MachineType == "" {
+		log.Printf("warning: not on GCE (or no metadata server): results are not comparable with VM runs")
+	}
+	if o.setup {
+		if err := setupDatasets(ctx, o.bucket, o.prefix, cases); err != nil {
+			return err
+		}
+	}
+	f, err := os.OpenFile(o.out, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0o644)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	exe, err := os.Executable()
+	if err != nil {
+		return err
+	}
+
+	log.Printf("run %s: %d cases x %d backends = %d pairs, %d rounds, seed %d, machine %q, output %s",
+		o.runID, len(cases), len(bes), len(pairs), o.rounds, o.seed, env.MachineType, o.out)
+	rng := rand.New(rand.NewPCG(uint64(o.seed), 0x5eed))
+	enc := json.NewEncoder(f)
+	failures := 0
+	for round := 1; round <= o.rounds; round++ {
+		for seq, idx := range rng.Perm(len(pairs)) {
+			p := pairs[idx]
+			res, err := runChild(ctx, exe, o, p, round)
+			if err != nil {
+				failures++
+				log.Printf("[round %d/%d %d/%d] %s %s: FAILED: %v", round, o.rounds, seq+1, len(pairs), p.c.Name, p.b.name, err)
+				res = &result{Schema: resultSchema, Time: time.Now().UTC(), Backend: p.b.name, Engine: p.b.engine,
+					Transport: p.b.transport, Case: p.c, Failed: true, Error: err.Error()}
+			} else {
+				log.Printf("[round %d/%d %d/%d] %s %s: %s", round, o.rounds, seq+1, len(pairs), p.c.Name, p.b.name, oneLine(res))
+			}
+			res.RunID, res.Round, res.Seq, res.Env = o.runID, round, seq+1, env
+			if err := enc.Encode(res); err != nil {
+				return err
+			}
+			if err := f.Sync(); err != nil {
+				return err
+			}
+			time.Sleep(o.cooldown)
+		}
+	}
+	log.Printf("run %s done: %d results, %d failed; summarize with: rustbench-report %s", o.runID, len(pairs)*o.rounds, failures, o.out)
+	return nil
+}
+
+func runChild(ctx context.Context, exe string, o suiteOptions, p pair, round int) (*result, error) {
+	cj, err := json.Marshal(p.c)
+	if err != nil {
+		return nil, err
+	}
+	cctx, cancel := context.WithTimeout(ctx, o.timeout)
+	defer cancel()
+	cmd := exec.CommandContext(cctx, exe, "run", "-bucket", o.bucket, "-prefix", o.prefix, "-backend", p.b.name,
+		"-case-json", string(cj), "-run-id", o.runID, "-round", strconv.Itoa(round))
+	cmd.Stderr = os.Stderr
+	out, err := cmd.Output()
+	if err != nil {
+		return nil, fmt.Errorf("child process: %w", err)
+	}
+	var res result
+	if err := json.Unmarshal(bytes.TrimSpace(out), &res); err != nil {
+		return nil, fmt.Errorf("decoding the child's result %q: %w", out, err)
+	}
+	return &res, nil
+}
+
+func oneLine(r *result) string {
+	var b strings.Builder
+	switch {
+	case r.Bytes > 0:
+		fmt.Fprintf(&b, "%.1f MiB/s", r.MiBPerS)
+	case r.Entries > 0:
+		fmt.Fprintf(&b, "%.0f entries/s", r.EntriesPerS)
+	}
+	fmt.Fprintf(&b, ", %.1f ops/s, p50 %.1f ms, p99 %.1f ms, cpu %.2f ms/op", r.OpsPerS, r.LatencyMs.P50, r.LatencyMs.P99, r.CPUMsPerOp)
+	if r.CPUSPerGiB > 0 {
+		fmt.Fprintf(&b, " (%.2f s/GiB)", r.CPUSPerGiB)
+	}
+	fmt.Fprintf(&b, ", peak rss %.0f MiB, threads %d", r.RSSPeakMiB, r.ThreadsMax)
+	if r.Errors > 0 {
+		fmt.Fprintf(&b, ", %d ERRORS (first: %s)", r.Errors, r.FirstError)
+	}
+	return b.String()
+}
diff --git a/storage/internal/rustcore/cmd/rustbench/workload.go b/storage/internal/rustcore/cmd/rustbench/workload.go
new file mode 100644
index 0000000..84962a3
--- /dev/null
+++ b/storage/internal/rustcore/cmd/rustbench/workload.go
@@ -0,0 +1,386 @@
+// Copyright 2026 Google LLC
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//      http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package main
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"log"
+	"math/rand/v2"
+	"runtime"
+	"sync"
+	"time"
+
+	"cloud.google.com/go/storage"
+	"cloud.google.com/go/storage/experimental"
+	"google.golang.org/api/iterator"
+)
+
+// opTimeout bounds every single operation, so a hung request fails the op instead of the run.
+const opTimeout = 10 * time.Minute
+
+type opResult struct {
+	bytes   int64
+	entries int64
+	ttfb    time.Duration // reads: first byte; list: first page; 0 = not applicable
+}
+
+// opFunc performs one operation. i < 0 marks warmup ops.
+type opFunc func(ctx context.Context, worker, i int) (opResult, error)
+
+// runCase measures one case with one backend in this process.
+func runCase(ctx context.Context, bucket, prefix, backendName string, c benchCase) (*result, error) {
+	be, err := lookupBackend(backendName)
+	if err != nil {
+		return nil, err
+	}
+	if why, skip := be.skip[c.Workload]; skip {
+		return nil, fmt.Errorf("pair is skipped: %s", why)
+	}
+	if c.Concurrency < 1 || c.Ops < 1 {
+		return nil, errors.New("concurrency and ops must be at least 1")
+	}
+
+	// Harness memory first, so that the baseline RSS includes it and peak - baseline is the
+	// memory the client itself used.
+	var payload []byte
+	if c.Workload == wWrite {
+		payload = randomBytes(int(c.Size), 1)
+	}
+	bufs := make([][]byte, c.Concurrency)
+	for i := range bufs {
+		bufs[i] = make([]byte, c.ioBuf())
+	}
+	runtime.GC()
+	rssBase := procStatusKB("VmRSS")
+
+	t0 := time.Now()
+	client, err := be.newClient(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("creating the client: %w", err)
+	}
+	defer client.Close()
+	initMs := float64(time.Since(t0)) / float64(time.Millisecond)
+
+	w := &workload{client: client, bkt: client.Bucket(bucket), prefix: prefix, be: be, c: c, payload: payload, bufs: bufs,
+		token: fmt.Sprintf("%d", time.Now().UnixNano())}
+	var op opFunc
+	switch c.Workload {
+	case wWrite:
+		op = w.write
+	case wRead:
+		op = w.read
+	case wRange:
+		op = w.rangeRead
+	case wList:
+		op = w.list
+	default:
+		return nil, fmt.Errorf("unknown workload %q", c.Workload)
+	}
+
+	res := &result{Schema: resultSchema, Time: time.Now().UTC(), Backend: be.name, Engine: be.engine, Transport: be.transport,
+		Case: c, ClientInitMs: initMs, RSSBaseMiB: kbToMiB(rssBase)}
+
+	// Warmup: connections, TLS, tokens, caches. Not measured.
+	res.WarmupErrors = runWorkers(ctx, c.Concurrency, c.Warmup, op, nil)
+
+	// Measured phase: all workers start together, after every worker finished its warmup.
+	var mem0, mem1 runtime.MemStats
+	runtime.ReadMemStats(&mem0)
+	ffi0 := experimental.RustEngineStats()
+	cpu0 := cpuNow()
+	smp := startSampler()
+	rec := newRecorder()
+	start := time.Now()
+	res.Errors = runWorkers(ctx, c.Concurrency, c.Ops, op, rec)
+	wall := time.Since(start)
+	cpu1 := cpuNow()
+	res.ThreadsMax, res.GoroutinesMax = smp.finish()
+	ffi1 := experimental.RustEngineStats()
+	runtime.ReadMemStats(&mem1)
+
+	res.Ops, res.FirstError = len(rec.lat), rec.firstErr
+	res.Bytes, res.Entries = rec.bytes, rec.entries
+	res.WallS = wall.Seconds()
+	res.OpsPerS = float64(res.Ops) / res.WallS
+	if res.Bytes > 0 {
+		res.MiBPerS = float64(res.Bytes) / mib / res.WallS
+	}
+	if res.Entries > 0 {
+		res.EntriesPerS = float64(res.Entries) / res.WallS
+	}
+	res.LatencyMs = summarize(rec.lat)
+	if len(rec.ttfb) > 0 {
+		s := summarize(rec.ttfb)
+		res.TTFBMs = &s
+	}
+	res.CPUUserS, res.CPUSysS = cpu1.user-cpu0.user, cpu1.sys-cpu0.sys
+	cpu := res.CPUUserS + res.CPUSysS
+	if res.Bytes > 0 {
+		res.CPUSPerGiB = cpu / (float64(res.Bytes) / (1 << 30))
+	}
+	if res.Ops > 0 {
+		res.CPUMsPerOp = cpu * 1000 / float64(res.Ops)
+	}
+	res.RSSPeakMiB, res.RSSEndMiB = kbToMiB(procStatusKB("VmHWM")), kbToMiB(procStatusKB("VmRSS"))
+	res.GoGCs = mem1.NumGC - mem0.NumGC
+	res.GoGCPauseMs = float64(mem1.PauseTotalNs-mem0.PauseTotalNs) / 1e6
+	res.GoHeapSysMiB = float64(mem1.HeapSys) / mib
+	res.FFICalls = ffi1["ffi_calls"] - ffi0["ffi_calls"]
+	res.AsyncOps = ffi1["async_ops"] - ffi0["async_ops"]
+
+	w.deleteWritten(ctx) // after the measurements: not part of the results
+	return res, nil
+}
+
+// recorder collects the outcome of measured ops from all workers.
+type recorder struct {
+	mu        sync.Mutex
+	lat, ttfb []time.Duration
+	bytes     int64
+	entries   int64
+	firstErr  string
+}
+
+func newRecorder() *recorder { return &recorder{} }
+
+func (r *recorder) add(d time.Duration, o opResult, err error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if err != nil {
+		if r.firstErr == "" {
+			r.firstErr = err.Error()
+		}
+		return
+	}
+	r.lat = append(r.lat, d)
+	if o.ttfb > 0 {
+		r.ttfb = append(r.ttfb, o.ttfb)
+	}
+	r.bytes += o.bytes
+	r.entries += o.entries
+}
+
+// runWorkers runs ops ops on each of n workers concurrently and returns the number of failed
+// ops. With rec == nil (warmup) op indexes are negative and nothing is recorded.
+func runWorkers(ctx context.Context, n, ops int, op opFunc, rec *recorder) int {
+	var wg sync.WaitGroup
+	var mu sync.Mutex
+	failed := 0
+	for wk := 0; wk < n; wk++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for i := 0; i < ops; i++ {
+				idx := i
+				if rec == nil {
+					idx = -1 - i
+				}
+				octx, cancel := context.WithTimeout(ctx, opTimeout)
+				t := time.Now()
+				o, err := op(octx, wk, idx)
+				d := time.Since(t)
+				cancel()
+				if err != nil {
+					mu.Lock()
+					failed++
+					mu.Unlock()
+					if rec == nil {
+						log.Printf("warmup op failed: %v", err)
+					}
+				}
+				if rec != nil {
+					rec.add(d, o, err)
+				}
+			}
+		}()
+	}
+	wg.Wait()
+	return failed
+}
+
+type workload struct {
+	client  *storage.Client
+	bkt     *storage.BucketHandle
+	prefix  string
+	be      backend
+	c       benchCase
+	payload []byte
+	bufs    [][]byte // one per worker: the application's Read buffer
+	token   string   // makes written object names unique per process
+
+	mu      sync.Mutex
+	written []string
+}
+
+// write uploads the payload in IOBuf-sized Write calls.
+func (w *workload) write(ctx context.Context, worker, i int) (opResult, error) {
+	name := fmt.Sprintf("%s/write/%s/%s/%s/w%02d-%05d", w.prefix, w.c.Name, w.be.name, w.token, worker, i)
+	if i < 0 {
+		name = fmt.Sprintf("%s/write/%s/%s/%s/w%02d-warm%d", w.prefix, w.c.Name, w.be.name, w.token, worker, -i)
+	}
+	ow := w.bkt.Object(name).NewWriter(ctx)
+	step := w.c.ioBuf()
+	for off := 0; off < len(w.payload); off += step {
+		if _, err := ow.Write(w.payload[off:min(off+step, len(w.payload))]); err != nil {
+			ow.Close()
+			return opResult{}, fmt.Errorf("write %s: %w", name, err)
+		}
+	}
+	err := ow.Close()
+	w.mu.Lock()
+	w.written = append(w.written, name) // also after a failed Close: the object may exist
+	w.mu.Unlock()
+	if err != nil {
+		return opResult{}, fmt.Errorf("close %s: %w", name, err)
+	}
+	return opResult{bytes: int64(len(w.payload))}, nil
+}
+
+// read downloads a whole dataset object with IOBuf-sized Read calls.
+func (w *workload) read(ctx context.Context, worker, i int) (opResult, error) {
+	n := datasetCount(w.c.Size)
+	name := readObjectName(w.prefix, w.c.Size, (worker+max(i, 0)*w.c.Concurrency)%n)
+	return w.download(ctx, w.bkt.Object(name), 0, -1, w.c.Size, w.bufs[worker])
+}
+
+// rangeRead downloads RangeSize bytes at a random offset of a dataset object.
+func (w *workload) rangeRead(ctx context.Context, worker, i int) (opResult, error) {
+	n := datasetCount(w.c.Size)
+	name := readObjectName(w.prefix, w.c.Size, worker%n)
+	off := rand.Int64N(w.c.Size - w.c.RangeSize + 1)
+	return w.download(ctx, w.bkt.Object(name), off, w.c.RangeSize, w.c.RangeSize, w.bufs[worker])
+}
+
+func (w *workload) download(ctx context.Context, o *storage.ObjectHandle, off, length, want int64, buf []byte) (opResult, error) {
+	t0 := time.Now()
+	r, err := o.NewRangeReader(ctx, off, length)
+	if err != nil {
+		return opResult{}, fmt.Errorf("open %s: %w", o.ObjectName(), err)
+	}
+	defer r.Close()
+	var res opResult
+	for {
+		// Plain Read calls: every backend sees the same call pattern (no WriterTo shortcuts).
+		n, err := r.Read(buf)
+		if n > 0 && res.bytes == 0 {
+			res.ttfb = time.Since(t0)
+		}
+		res.bytes += int64(n)
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			return opResult{}, fmt.Errorf("read %s: %w", o.ObjectName(), err)
+		}
+	}
+	if res.bytes != want {
+		return opResult{}, fmt.Errorf("read %s: got %d bytes, want %d", o.ObjectName(), res.bytes, want)
+	}
+	return res, nil
+}
+
+// list lists the whole list dataset (every page).
+func (w *workload) list(ctx context.Context, worker, i int) (opResult, error) {
+	t0 := time.Now()
+	q := &storage.Query{Prefix: listPrefix(w.prefix, w.c.Objects), Delimiter: w.c.Delimiter}
+	p := iterator.NewPager(w.bkt.Objects(ctx, q), w.c.PageSize, "")
+	var res opResult
+	for {
+		var page []*storage.ObjectAttrs
+		tok, err := p.NextPage(&page)
+		if err != nil {
+			return opResult{}, fmt.Errorf("list %s: %w", q.Prefix, err)
+		}
+		if res.ttfb == 0 {
+			res.ttfb = time.Since(t0)
+		}
+		res.entries += int64(len(page))
+		if tok == "" {
+			break
+		}
+	}
+	want := int64(w.c.Objects)
+	if w.c.Delimiter != "" {
+		want = int64(listDirs(w.c.Objects))
+	}
+	if res.entries != want {
+		return opResult{}, fmt.Errorf("list %s: got %d entries, want %d (run `rustbench setup`)", q.Prefix, res.entries, want)
+	}
+	return res, nil
+}
+
+// deleteWritten removes the objects this process uploaded.
+func (w *workload) deleteWritten(ctx context.Context) {
+	w.mu.Lock()
+	names := w.written
+	w.mu.Unlock()
+	if len(names) == 0 {
+		return
+	}
+	failed := parallelDo(ctx, len(names), 32, func(ctx context.Context, i int) error {
+		err := w.bkt.Object(names[i]).Delete(ctx)
+		if errors.Is(err, storage.ErrObjectNotExist) {
+			return nil
+		}
+		return err
+	})
+	if failed > 0 {
+		log.Printf("could not delete %d of %d written objects (rustbench cleanup removes them)", failed, len(names))
+	}
+}
+
+// randomBytes returns n bytes of seeded pseudo-random (incompressible) data.
+func randomBytes(n int, seed uint64) []byte {
+	b := make([]byte, n)
+	r := rand.NewChaCha8([32]byte{byte(seed), byte(seed >> 8), 'r', 'u', 's', 't', 'b', 'e', 'n', 'c', 'h'})
+	r.Read(b)
+	return b
+}
+
+// parallelDo runs f(0..n-1) on `workers` goroutines and returns the number of failures.
+func parallelDo(ctx context.Context, n, workers int, f func(context.Context, int) error) int {
+	idx := make(chan int)
+	var failed int
+	var mu sync.Mutex
+	var wg sync.WaitGroup
+	for range min(workers, n) {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for i := range idx {
+				octx, cancel := context.WithTimeout(ctx, opTimeout)
+				err := f(octx, i)
+				cancel()
+				if err != nil {
+					mu.Lock()
+					if failed == 0 {
+						log.Printf("first failure: %v", err)
+					}
+					failed++
+					mu.Unlock()
+				}
+			}
+		}()
+	}
+	for i := 0; i < n; i++ {
+		idx <- i
+	}
+	close(idx)
+	wg.Wait()
+	return failed
+}
